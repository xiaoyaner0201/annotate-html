{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/annotate-html/feedback-v1.schema.json",
  "title": "Annotate HTML feedback v1",
  "type": "object",
  "required": ["schema", "id", "kind", "title", "createdAt", "reporter", "page", "app", "annotations", "console", "network", "markdown"],
  "properties": {
    "schema": {"const": "annotate-html/feedback@1"},
    "id": {"type": "string", "format": "uuid"},
    "kind": {"type": "string"},
    "title": {"type": "string"},
    "createdAt": {"type": "string", "format": "date-time"},
    "reporter": {"type": "object", "required": ["type"], "properties": {"type": {"enum": ["human", "agent"]}, "name": {"type": "string"}, "id": {"type": "string"}}},
    "page": {"type": "object"},
    "app": {"type": "object", "properties": {"version": {"type": "string"}}},
    "annotations": {"type": "array", "items": {"type": "object", "required": ["id", "comment", "element"], "properties": {"id": {"type": "string"}, "comment": {"type": "string"}, "element": {"type": "object"}, "screenshot": {"type": "object", "required": ["part", "width", "height", "type", "region"], "properties": {"part": {"type": "string"}, "width": {"type": "integer"}, "height": {"type": "integer"}, "type": {"enum": ["image/png", "image/jpeg"]}, "region": {"type": "object"}}}}}},
    "console": {"type": "array", "items": {"type": "object"}},
    "network": {"type": "array", "items": {"type": "object"}},
    "markdown": {"type": "string"}
  }
}
